node_modules/
dist/
*.tsbuildinfo
.DS_Store
.env*
!.env.example

# design-sync working dirs (regenerated; never committed).
# The durable set under .design-sync/ (config.json, NOTES.md, conventions.md,
# previews/, overrides/) IS committed — only these machine/scratch paths are not.
.ds-sync/
ds-bundle/
.design-sync/.cache/
.design-sync/learnings/
.design-sync/node_modules

# Agent-local state. `.claude/worktrees/` holds this checkout's worktrees and
# `.claude/launch.json` is written by whichever tool last started a dev server —
# both are machine state, not repository state. Nothing here has ever been
# tracked; this stops it arriving by accident.
.claude/

# Next.js (apps/docs)
.next/
out/
next-env.d.ts

# Generated documentation data + assets (rebuilt by apps/docs/scripts/generate.mjs)
apps/docs/src/generated/
apps/docs/public/fonts/
*.tsbuildinfo

# Playwright (apps/docs)
apps/docs/test-results/
apps/docs/playwright-report/
apps/docs/.wrangler/
.wrangler/

# Playwright MCP page dumps, written by an agent driving the built site.
.playwright-mcp/
