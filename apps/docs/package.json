{
  "name": "@misoto22/design-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ui.misoto22.com — the documentation and component gallery for @misoto22/design",
  "scripts": {
    "predev": "node scripts/generate.mjs",
    "dev": "next dev --port ${PORT:-4023}",
    "prebuild": "node scripts/generate.mjs",
    "build": "next build",
    "start": "next start",
    "generate": "node scripts/generate.mjs",
    "lint": "eslint src scripts",
    "typecheck": "node scripts/generate.mjs && tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf .next out src/generated",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "dependencies": {
    "@misoto22/design": "workspace:*",
    "lucide-react": "^1.33.0",
    "next": "16.3.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-live": "^4.1.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.26",
    "shiki": "^4.4.3",
    "tailwindcss": "4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
}
