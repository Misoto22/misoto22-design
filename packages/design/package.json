{
  "name": "@misoto22/design",
  "version": "0.6.1",
  "private": false,
  "description": "Monochrome design system — CSS tokens and accessible React primitives",
  "license": "MIT",
  "author": "Henry Chen",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "skills",
    "bin",
    "LICENSE",
    "README.md"
  ],
  "bin": {
    "misoto22-design": "./bin/misoto22-design.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./charts": {
      "types": "./dist/charts/index.d.ts",
      "import": "./dist/charts/index.js"
    },
    "./diagrams": {
      "types": "./dist/diagrams/index.d.ts",
      "import": "./dist/diagrams/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./semantic.css": "./dist/semantic.css",
    "./keyframes.css": "./dist/keyframes.css",
    "./fonts.css": "./dist/fonts.css",
    "./tokens.json": "./dist/tokens.json",
    "./tokens": {
      "types": "./dist/tokens.d.ts",
      "import": "./dist/tokens.js"
    },
    "./themes.css": "./dist/themes.css",
    "./article.css": "./dist/article.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:fonts": "node scripts/vendor-fonts.mjs",
    "build:js": "NODE_OPTIONS=--max-old-space-size=6144 tsup",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify && node scripts/copy-portable-css.mjs && node scripts/emit-tokens.mjs",
    "build:agent": "node scripts/emit-agent.mjs",
    "build": "pnpm run build:fonts && pnpm run build:js && pnpm run build:css && pnpm run build:agent",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src scripts agent bin",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "check:size": "node scripts/check-size.mjs",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "peerDependencies": {
    "motion": "^12.23.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.8.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-avatar": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-context-menu": "^2.3.7",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.3.11",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slider": "^1.4.7",
    "@radix-ui/react-slot": "^1.2.8",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-toggle-group": "^1.1.19",
    "@radix-ui/react-tooltip": "^1.2.12",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.33.0",
    "react-day-picker": "^10.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@fontsource/hanken-grotesk": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "axe-core": "^4.13.0",
    "culori": "^4.0.2",
    "esbuild": "^0.28.2",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "jsdom": "^29.1.1",
    "motion": "^12.43.0",
    "publint": "^0.3.24",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "3.8.0",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Misoto22/misoto22-design.git",
    "directory": "packages/design"
  },
  "keywords": [
    "design-system",
    "react",
    "tailwind",
    "radix",
    "components",
    "tokens",
    "accessibility"
  ],
  "homepage": "https://ui.misoto22.com",
  "bugs": {
    "url": "https://github.com/Misoto22/misoto22-design/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependenciesMeta": {
    "motion": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  }
}
