{
  "name": "@misoto22/design",
  "version": "0.1.0",
  "private": false,
  "description": "misoto22 design system \u2014 White Reset tokens, brand mirrors, and accessible React primitives",
  "license": "UNLICENSED",
  "author": "Henry Chen",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css",
    "./semantic.css": "./dist/semantic.css",
    "./keyframes.css": "./dist/keyframes.css",
    "./fonts.css": "./dist/fonts.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:fonts": "node scripts/vendor-fonts.mjs",
    "build:js": "NODE_OPTIONS=--max-old-space-size=6144 tsup",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify && node scripts/copy-portable-css.mjs",
    "build": "pnpm run build:fonts && pnpm run build:js && pnpm run build:css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-accordion": "^1.2.14",
    "@radix-ui/react-avatar": "^1.1.14",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-progress": "^1.1.10",
    "@radix-ui/react-radio-group": "^1.3.11",
    "@radix-ui/react-slot": "^1.2.8",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.12",
    "clsx": "^2.1.1",
    "lucide-react": "^1.33.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@fontsource/hanken-grotesk": "^5.2.5",
    "@fontsource/ibm-plex-mono": "^5.2.5",
    "@fontsource/newsreader": "^5.2.5",
    "@tailwindcss/cli": "4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/culori": "^4.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "culori": "^4.0.2",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "jsdom": "^29.1.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "4.3.3",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Misoto22/misoto22-design.git",
    "directory": "packages/design"
  }
}
