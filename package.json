{
  "name": "misoto22-design-workspace",
  "private": true,
  "type": "module",
  "description": "misoto22 design system \u2014 the @misoto22/design package and its documentation site",
  "license": "UNLICENSED",
  "author": "Henry Chen",
  "scripts": {
    "build": "pnpm --filter @misoto22/design build && pnpm --filter @misoto22/design-docs build",
    "build:design": "pnpm --filter @misoto22/design build",
    "build:docs": "pnpm --filter @misoto22/design-docs build",
    "dev": "pnpm --filter @misoto22/design-docs dev",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "clean": "pnpm -r clean"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
