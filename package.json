{
  "name": "@misoto22/design",
  "version": "0.0.0",
  "private": false,
  "description": "misoto22 design system — tokens, brand, and React primitives shared by misoto22-site and misoto22-admin",
  "license": "UNLICENSED",
  "author": "Henry Chen",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tokens.css": "./dist/tokens.css"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build:js": "tsup",
    "build:css": "tailwindcss -i ./src/styles/index.css -o ./dist/styles.css --minify && cp ./src/styles/tokens.css ./dist/tokens.css",
    "build": "pnpm run build:js && pnpm run build:css",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.5",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-label": "^2.1.10",
    "@radix-ui/react-switch": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.15",
    "clsx": "^2.1.1",
    "lucide-react": "^1.22.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@fontsource/cormorant-garamond": "^5.2.11",
    "@fontsource/geist-sans": "^5.2.5",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@tailwindcss/cli": "4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "esbuild-fix-imports-plugin": "^1.0.23",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "tailwindcss": "4.3.0",
    "tsup": "^8.5.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24",
    "pnpm": ">=11"
  },
  "packageManager": "pnpm@11.9.0"
}
